# Enable MultiViews for automatic extension handling
Options +MultiViews -Indexes

# Block CLI migration scripts from web access (defense in depth)
<FilesMatch "^run_.*\.php$">
  Require all denied
</FilesMatch>

# Block database dumps and SQL files everywhere under web root
<FilesMatch "\.(sql|sql\.gz|dump)$">
  Require all denied
</FilesMatch>

# Block direct web access to sensitive directories
<IfModule mod_rewrite.c>
  RewriteEngine On
  # For production server (root domain) — UNCOMMENT ON PRODUCTION:
  # RewriteBase /
  # For local development (XAMPP in /swaapin subdir):
  RewriteBase /swaapin/

  # Force HTTPS (exclude localhost)
  # RewriteCond %{HTTPS} off
  # RewriteCond %{HTTP:X-Forwarded-Proto} !https
  # RewriteCond %{HTTP_HOST} !^localhost$ [NC]
  # RewriteCond %{HTTP_HOST} !^127\.0\.0\.1$
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Remove www (optional)
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Explicitly handle /profile/ to avoid directory listing
  RewriteRule ^profile/?$ profile.php [L,NC,QSA]
  
  # Block sensitive directories
  RewriteRule ^includes/ - [F,L]
  RewriteRule ^seed/ - [F,L]
  RewriteRule ^database/ - [F,L]
  RewriteRule ^storage/ - [F,L]
  RewriteRule ^tools/ - [F,L]
  RewriteRule ^vendor/ - [F,L]
  RewriteRule ^logs/ - [F,L]
  RewriteRule ^backups/ - [F,L]
  RewriteRule ^sql/ - [F,L]

  # ── FIX: /store and /support routes ────────────────────────────────────
  # These MUST come BEFORE the !-d checks because store/ and support/
  # are real directories. Without this, 404 occurs on servers where
  # DirectoryIndex or directory permission doesn't kick in fast enough.

  # /store OR /store/  →  store/index.php  (also allow /store/anything to go as-is)
  RewriteRule ^store/?$ store/index.php [L,NC,QSA]
  RewriteRule ^store/request/?$ store/request.php [L,NC,QSA]

  RewriteRule ^orders/?$ orders/index.php [L,NC,QSA]
  RewriteRule ^orders/checkout/?$ orders/checkout.php [L,NC,QSA]
  RewriteRule ^orders/view/?$ orders/view.php [L,NC,QSA]

  RewriteRule ^store-offers/?$ store-offers/index.php [L,NC,QSA]
  RewriteRule ^store-offers/create/?$ store-offers/create.php [L,NC,QSA]
  RewriteRule ^store-offers/view/?$ store-offers/view.php [L,NC,QSA]
  RewriteRule ^store-offers/success/?$ store-offers/success.php [L,NC,QSA]
  RewriteRule ^store-offers/confirm/?$ store-offers/confirm.php [L,NC,QSA]
  RewriteRule ^store-offers/complete/?$ store-offers/complete.php [L,NC,QSA]

  RewriteRule ^shops/?$ shops/index.php [L,NC,QSA]
  RewriteRule ^search/ai/?$ search/ai.php [L,NC,QSA]
  RewriteRule ^search/saved/?$ search/saved.php [L,NC,QSA]

  # /shop/<slug>  →  shop/index.php?slug=<slug>  (skip existing files like index.php)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^shop/(.+?)/?$ shop/index.php?slug=$1 [L,NC,QSA,B]

  # /support OR /support/  →  support/index.php
  RewriteRule ^support/?$ support/index.php [L,NC,QSA]

  # Handle trailing slashes for files (e.g., /profile/ -> /profile.php)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME} ^(.+)/$
  RewriteCond %1.php -f
  RewriteRule ^(.+)/$ $1.php [L,QSA]

  # Remove .php extension (prioritize files over directories)
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([^/]+)/?$ $1.php [L,QSA]
  
  # Handle /sep/callback route for backward compatibility
  RewriteRule ^sep/callback/?$ payment_callback.php [L,NC,QSA]

  # Category URLs (e.g., /category/digital → /listings/all.php?cat=electronics)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^category/digital/?$ listings/all.php?cat=electronics [L,NC,QSA]
  RewriteRule ^category/electronics/?$ listings/all.php?cat=electronics [L,NC,QSA]
  RewriteRule ^category/clothing/?$ listings/all.php?cat=clothing [L,NC,QSA]
  RewriteRule ^category/home-and-villa/?$ listings/all.php?cat=home-garden [L,NC,QSA]
  RewriteRule ^category/home-garden/?$ listings/all.php?cat=home-garden [L,NC,QSA]
  RewriteRule ^category/books-media/?$ listings/all.php?cat=books-media [L,NC,QSA]
  RewriteRule ^category/sports/?$ listings/all.php?cat=sports [L,NC,QSA]
  RewriteRule ^category/toys-games/?$ listings/all.php?cat=toys-games [L,NC,QSA]
  RewriteRule ^category/vehicles/?$ listings/all.php?cat=vehicles [L,NC,QSA]
  RewriteRule ^category/services/?$ listings/all.php?cat=services [L,NC,QSA]
  RewriteRule ^category/food-drink/?$ listings/all.php?cat=food-drink [L,NC,QSA]
  RewriteRule ^category/other/?$ listings/all.php?cat=other [L,NC,QSA]

  # Handle subdirectories like /auth/login
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/swaapin/$1.php -f
  RewriteRule ^(.+?)/?$ $1.php [L,QSA]
</IfModule>

# ── FIX: Explicit DirectoryIndex for folders like /store ──────────────────
# Ensures that on servers where MultiViews is flaky, going to /store/
# or /support/ will still load the index.php inside them.
DirectoryIndex index.php index.html

# Custom error documents
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php

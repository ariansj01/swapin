# Enable MultiViews for automatic extension handling
Options -MultiViews -Indexes

# Block CLI migration scripts from web access (defense in depth)
<FilesMatch "^run_.*\.php$">
  Require all denied
</FilesMatch>

# Block database dumps and SQL files everywhere under web root
<FilesMatch "\.(sql|sql\.gz|dump)$">
  Require all denied
</FilesMatch>

# Block direct web access to sensitive directories
<IfModule mod_rewrite.c>
  RewriteEngine On
  # For production server (root domain) — adjust RewriteBase if deployed at domain root:
  # RewriteBase /
  # For local development (XAMPP in /swaapin subdir):
  # RewriteBase /swaapin/
  # For production or root:
  # RewriteBase /

  # ── حذف اسلش انتهایی (سئو — P2) ─────────────────────────────────────────
  # هر آدرس با اسلش انتهایی با ۳۰۱ به نسخهٔ بدون اسلش می‌رود (پارامترها حفظ
  # می‌شوند). استثناها: صفحهٔ خانه، /blog و مسیرهای قدیمی که خودشان در همان
  # یک مرحله به مقصد کانونیکال ۳۰۱ می‌شوند (تا زنجیرهٔ ریدایرکت ساخته نشود).
  RewriteCond %{REQUEST_URI} !^/(?:blog|meta|services|pwa|download|exchange|listings|shops|category|real-estate|vehicles|electronics|home-kitchen|personal-items|leisure-hobbies|tools-equipment|jobs|clothing|l)(?:/|$)
  RewriteRule ^(.+?)/+$ /$1 [R=301,L,QSA]

  # Landing pages
  # نقشهٔ ۳۰۱: صفحهٔ فرود «خدمات» به دستهٔ کانونیکال /iran/services منتقل شده است.
  RewriteRule ^services/?$ /iran/services [R=301,L,NC,QSD]
  RewriteRule ^services\.php$ /iran/services [R=301,L,NC,QSD]
  # نقشهٔ ۳۰۱: صفحهٔ نصب اپ (/pwa) به آدرس دانلود /app منتقل شده است.
  RewriteRule ^pwa/?$ /app [R=301,L,NC,QSD]
  RewriteRule ^pwa\.php$ /app [R=301,L,NC,QSD]

  # Mobile Flutter API (do not affect PWA routes)
  RewriteRule ^api/v1/index\.php$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api/v1/ api/v1/index.php [L,QSA]

  # User ↔ user chat API (AJAX)
  RewriteRule ^api/user_chat/?$ api/user_chat.php [L,NC,QSA]

  # canonical host + protocol در «یک مرحله» (نقشهٔ ۳۰۱ — ردیف ۱۴۱):
  # www (با هر پروتکلی) مستقیماً به https بدون www می‌رود تا زنجیرهٔ
  # http → www → non-www ساخته نشود.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteCond %1 !^localhost(:[0-9]+)?$ [NC]
  RewriteCond %1 !^127\.0\.0\.1(:[0-9]+)?$
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Force HTTPS (exclude localhost & 127.0.0.1 for local dev)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^localhost(:[0-9]+)?$ [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:[0-9]+)?$
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # نقشه مستقل حذف شد؛ آدرس آن در یک مرحله به صفحهٔ دسته/مکان معادل ۳۰۱ می‌شود (سند — Q19)
  RewriteRule ^listings/map/?$ listings/map_view.php [L,NC,QSA]
  RewriteRule ^listings/map_view\.php$ - [L,NC,QSA]

  # /exchange طبق سند به صفحه اصلی منتقل شده است
  RewriteRule ^exchange/?$ / [R=301,L]
  RewriteRule ^exchange\.php$ / [R=301,L]

  # دانلود اپلیکیشن — آدرس کانونیکال /app (طبق معماری سئو)
  RewriteRule ^app/?$ download.php [L,NC,QSA]
  RewriteRule ^download/?$ /app [R=301,L,NC]

  # نقشهٔ ۳۰۱: لینک کوتاه «/l» (در محتوای بلاگ) → صفحهٔ اصلی.
  RewriteRule ^l/?$ / [R=301,L,NC]

  # ── سایت‌مپ‌های تفکیک‌شده (سند معماری سئو — بخش ۷) ─────────────────────
  # .xml → مولد PHP متناظر؛ sitemap.php و sitemap-main.xml قدیمی → 301 به ایندکس.
  RewriteRule ^sitemap\.xml$ sitemap-index.php [L,NC]
  RewriteRule ^sitemap\.php$ /sitemap.xml [R=301,L,NC]
  RewriteRule ^sitemap-main\.xml$ /sitemap.xml [R=301,L,NC]
  RewriteRule ^sitemap-(locations|categories|brands|swap|shops|pages)\.xml$ sitemap-$1.php [L,NC]
  RewriteRule ^sitemap-ads-([0-9]+)\.xml$ sitemap-ads.php?chunk=$1 [L,NC,QSA]
  RewriteRule ^sitemap-ads\.xml$ sitemap-ads.php [L,NC,QSA]

  # ── نقشه ریدایرکت مهاجرت (سند معماری سئو — بخش ۱۱) ─────────────────────
  # آدرس‌های قدیمی/تودرتوی دسته‌ها → کانونیکال /iran/{leaf}.
  # وقتی پارامتر city هست، ریدایرکت به روتر (category/index.php) واگذار می‌شود
  # تا مکان درست در مسیر ساخته شود (/{location}/{category}) و پارامتر از دست نرود.
  RewriteCond %{QUERY_STRING} !(?:^|&)city= [NC]
  RewriteRule ^real-estate/?$ /iran/real-estate [R=301,L,NC,QSD]
  RewriteCond %{QUERY_STRING} !(?:^|&)city= [NC]
  RewriteRule ^vehicles/cars/passenger-cars/?$ /iran/car [R=301,L,NC,QSD]
  RewriteCond %{QUERY_STRING} !(?:^|&)city= [NC]
  RewriteRule ^electronics/mobile-tablet/mobile-phones/?$ /iran/mobile-phones [R=301,L,NC,QSD]

  # صفحه اصلی آگهی‌ها: /listings (بدون پارامتر) → کانونیکال کشور /iran
  # با پارامتر (city/cat/q) → روتر صفحهٔ اصلی، تا در یک مرحله به مسیر کانونیکال
  # /{location}/{category} ۳۰۱ شود (نقشهٔ ۳۰۱ — ردیف‌های ۱۲۰-۱۲۲).
  RewriteCond %{QUERY_STRING} ^$
  RewriteRule ^listings/?$ /iran [R=301,L,NC,QSD]
  RewriteRule ^listings/?$ index.php [L,QSA]
  RewriteRule ^listings\.php$ /iran [R=301,L,NC,QSD]
  RewriteRule ^listings/all/?$ /iran [R=301,L,NC,QSD]
  RewriteRule ^listings/all\.php$ /iran [R=301,L,NC,QSD]

  # Explicitly handle /profile/ to avoid directory listing
  RewriteRule ^profile/?$ profile.php [L,NC,QSA]
  
  # Block sensitive files and directories
  RewriteRule \.(env|zip|bak|sql|dump|ini|log|sh|git|jsonl)$ - [F,L]
  RewriteRule ^(includes|seed|database|storage|tools|vendor|logs|backups|sql)/ - [F,L]

  # ── FIX: /store and /support routes ────────────────────────────────────
  # These MUST come BEFORE the !-d checks because store/ and support/
  # are real directories. Without this, 404 occurs on servers where
  # DirectoryIndex or directory permission doesn't kick in fast enough.

  # /store OR /store/  →  store/index.php  (also allow /store/anything to go as-is)
  RewriteRule ^store/?$ store/index.php [L,NC,QSA]
  RewriteRule ^store/request/?$ store/request.php [L,NC,QSA]

  RewriteRule ^clubs/?$ clubs/index.php [L,NC,QSA]
  RewriteRule ^clubs/create/?$ clubs/create.php [L,NC,QSA]
  RewriteRule ^clubs/mine/?$ clubs/mine.php [L,NC,QSA]
  RewriteRule ^clubs/([a-zA-Z0-9\-]+)/?$ clubs/view.php?slug=$1 [L,NC,QSA]

  RewriteRule ^orders/?$ orders/index.php [L,NC,QSA]
  RewriteRule ^orders/checkout/?$ orders/checkout.php [L,NC,QSA]
  RewriteRule ^orders/view/?$ orders/view.php [L,NC,QSA]

  # User ↔ user chat pages
  RewriteRule ^chat/?$ chat/index.php [L,NC,QSA]
  RewriteRule ^chat/view/?$ chat/view.php [L,NC,QSA]

  # /trades با پوشه trades/ تداخل دارد؛ بدون این قانون ?tab=received صفحه سفید می‌شود
  RewriteRule ^trades/?$ trades.php [L,NC,QSA]
  RewriteRule ^trades/view/?$ trades/view.php [L,NC,QSA]
  RewriteRule ^trades/group/?$ trades/group.php [L,NC,QSA]
  RewriteRule ^trades/fee/?$ trades/fee.php [L,NC,QSA]

  RewriteRule ^store-offers/?$ store-offers/index.php [L,NC,QSA]
  RewriteRule ^store-offers/create/?$ store-offers/create.php [L,NC,QSA]
  RewriteRule ^store-offers/view/?$ store-offers/view.php [L,NC,QSA]
  RewriteRule ^store-offers/success/?$ store-offers/success.php [L,NC,QSA]
  RewriteRule ^store-offers/confirm/?$ store-offers/confirm.php [L,NC,QSA]
  RewriteRule ^store-offers/complete/?$ store-offers/complete.php [L,NC,QSA]

  # 301 Redirect: old /shops?type=X to new clean URLs /shops/X
  RewriteCond %{QUERY_STRING} (?:^|&)type=online(?:&|$) [NC]
  RewriteRule ^shops/?$ /shops/online? [R=301,L,NC]
  RewriteCond %{QUERY_STRING} (?:^|&)type=physical(?:&|$) [NC]
  RewriteRule ^shops/?$ /shops/physical? [R=301,L,NC]

  RewriteRule ^shops/?$ shops/index.php [L,NC,QSA]
  RewriteRule ^shops/online/?$ shops/index.php?type=online [L,NC,QSA]
  RewriteRule ^shops/physical/?$ shops/index.php?type=physical [L,NC,QSA]
  RewriteRule ^search/ai/?$ search/ai.php [L,NC,QSA]
  RewriteRule ^search/saved/?$ search/saved.php [L,NC,QSA]

  # فروشگاه تستی حذف‌شده (Q05) → ۴۱۰ Gone مستقیم، بدون ریدایرکت میانی به /shop/{slug}
  RewriteRule ^shop/(?:online|physical|both)/(?:test|myket-test-store)/?$ - [G,L,NC]
  RewriteRule ^shop/(?:test|myket-test-store)/?$ - [G,L,NC]

  # 301: آدرس‌های قدیمی /shop/<type>/<slug> → آدرس کانونیکال /shop/<slug>
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^shop/(online|physical|both)/(.+?)/?$ /shop/$2 [R=301,L,NC]
  # آدرس کانونیکال فروشگاه: /shop/<slug>  (طبق معماری سئو)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^shop/(.+?)/?$ shop/index.php?slug=$1 [L,NC,QSA,B]

  # /support OR /support/  →  support/index.php
  RewriteRule ^support/?$ support/index.php [L,NC,QSA]

  # Handle trailing slashes for files (e.g., /profile/ -> /profile.php)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME} ^(.+)/$
  RewriteCond %{DOCUMENT_ROOT}/$1.php -f
  RewriteRule ^(.+)/$ $1.php [L,QSA]

  # Remove .php extension (prioritize files over directories)
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([^/]+)/?$ $1.php [L,QSA]

  # توجه: /pwa طبق نقشه مهاجرت (بخش ۱۱) با ۳۰۱ به /app منتقل می‌شود و بالاتر در همین فایل مدیریت شده است.

  # توجه: /listings و /listings/ طبق نقشه مهاجرت (بخش ۱۱) با ۳۰۱ به /iran منتقل می‌شوند
  # و بالاتر در همین فایل مدیریت شده‌اند.


  # AI capabilities lab (interactive demos, no DB writes)
  RewriteRule ^ai-lab/?$ ai-lab.php [L,NC,QSA]

  # Handle /sep/callback route for backward compatibility
  RewriteRule ^sep/callback/?$ payment_callback.php [L,NC,QSA]

  # Legacy malformed /{APP_URL}/category/<slug> URLs (an old broken template rendered "{APP_URL}" literally).
  # Route them to the canonical category resolver, which issues a 301 to the real category URL.
  RewriteRule ^(?:\{APP_URL\}|%7BAPP_URL%7D)/category/(.+?)/?$ category/index.php?redirect_slugs=$1 [L,NC,QSA]

  # 301 Redirect old /category/* URLs to new hierarchical URLs (without /category prefix)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^category/(.+)$ category/index.php?redirect_slugs=$1 [L,NC,QSA]

  # فاز ۱: آدرس آگهی /{fa-slug}/{id} از طریق همین قوانین به روتر می‌رسد؛
  # مسیر کوتاه /{id} (وقتی اسلاگ ساخته نشود) مستقیماً به صفحه آگهی می‌رود.
  RewriteRule ^([0-9]+)/?$ listings/view.php?id=$1 [L,QSA]

  # New hierarchical category URLs (e.g., /electronics/phones → without /category prefix)
  # Must exclude real routes/files/dirs and known system prefixes
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !^/(api|admin|includes|seed|database|storage|tools|vendor|logs|backups|sql|store|orders|chat|store-offers|shops|search|shop|support|pwa|ai-lab|sep|iso|listing|listings|auth|page|src|css|js|assets|scripts|ops)/ [NC]
  RewriteCond %{REQUEST_URI} !^/(index\.php|profile\.php|dashboard\.php|404\.php|500\.php|sitemap\.php|payment_callback\.php|ai-lab\.php|pwa\.php|migration_[^/]+\.php) [NC]
  RewriteRule ^([^/].+)$ category/index.php?slug_path=$1 [L,QSA]

  # Handle subdirectories like /auth/login
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/swaapin/$1.php -f
  RewriteRule ^(.+?)/?$ $1.php [L,QSA]
</IfModule>

# ── FIX: Explicit DirectoryIndex for folders like /store ──────────────────
# Ensures that on servers where MultiViews is flaky, going to /store/
# or /support/ will still load the index.php inside them.
DirectoryIndex index.php index.html

# Custom error documents
ErrorDocument 404 /404.php
ErrorDocument 410 /410.php
ErrorDocument 500 /500.php
